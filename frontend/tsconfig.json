{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@designcodeio/threeui/style.css": ["src/shaders/threeui.css"],
      "@designcodeio/threeui": ["src/shaders/animated-top-dock/AnimatedTopDock.tsx"],
      "@designcodeio/threeui/*": ["src/shaders/*"]
    }
  },
  "include": ["src"]
}
