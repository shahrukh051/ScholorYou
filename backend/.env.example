# Backend CORS — set to your Vercel frontend URL in production
# Example: FRONTEND_ORIGIN=https://scholoryou.vercel.app
# For multiple origins: FRONTEND_ORIGIN=https://scholoryou.vercel.app,https://www.scholoryou.com
FRONTEND_ORIGIN=http://localhost:5173

# LLM Provider — use any OpenAI-compatible API
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
