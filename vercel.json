{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "scholoryou-frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "scholoryou-frontend" }
    }
  ]
}
